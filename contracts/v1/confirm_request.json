{
  "$defs": {
    "DeviceAuth": {
      "properties": {
        "method": {
          "default": "biometric",
          "description": "Device unlock method: 'biometric' or 'device_credential'",
          "title": "Method",
          "type": "string"
        },
        "kid": {
          "description": "Key ID matching session device_key.kid",
          "title": "Kid",
          "type": "string"
        },
        "alg": {
          "default": "ES256",
          "description": "Signature algorithm (ES256)",
          "title": "Alg",
          "type": "string"
        },
        "signature": {
          "description": "Base64 DER ECDSA signature over accessai-auth-v1|{session_id}|{pending_id}|{action_id}|{params_sha256}",
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "kid",
        "signature"
      ],
      "title": "DeviceAuth",
      "type": "object"
    }
  },
  "properties": {
