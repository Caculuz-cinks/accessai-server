# Service Configuration
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_PATH=voice_intent.db

# LLM Provider: 'groq', 'anthropic', or 'mock'
LLM_PROVIDER=groq

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic API Configuration (alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Security & Confirmation
CONFIDENCE_THRESHOLD=0.85
CONFIRMATION_TOKEN_TTL_SECONDS=60
ED25519_PRIVATE_KEY_B64=GPsvO8WtZlY8eSZQaobCeY5v2/+Z14jyUsuFkaJ5wJE=
JWKS_KID=voice-intent-key-1
